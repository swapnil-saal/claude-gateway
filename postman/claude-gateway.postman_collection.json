                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "messages"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"haiku\",\n  \"max_tokens\": 200,\n  \"system\": \"Always answer in French, one word.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"What colour is the sky?\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Multi-turn history",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "messages"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"haiku\",\n  \"max_tokens\": 100,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"My code word is PINEAPPLE-7.\"\n    },\n    {\n      \"role\": \"assistant\",\n      \"content\": \"Noted.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"What is my code word?\"\n    }\n  ]\n}",
