              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "messages"
              ]
            },
            "description": "Returns text/event-stream: message_start, ping, content_block_*, message_delta, message_stop.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"haiku\",\n  \"max_tokens\": 1024,\n  \"stream\": true,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Count to 10\"\n    }\n  ]\n}",
