              ],
              "path": [
                "v1",
                "messages"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"claude-sonnet-5-5\",\n  \"max_tokens\": 4000,\n  \"thinking\": {\n    \"type\": \"enabled\",\n    \"budget_tokens\": 2000\n  },\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"What is 17 * 23?\"\n    }\n  ]\n}",
              "options": {
