            "url": {
              "raw": "{{baseUrl}}/v1/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "messages"
              ]
            },
            "description": "x-session-id keeps one Claude Code process for the conversation.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"haiku\",\n  \"max_tokens\": 200,\n  \"system\": \"You are a pirate.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"My name is Sam.\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2. Session: second turn",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-session-id",
                "value": "{{sessionId}}"
              },
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "messages"
              ]
            },
            "description": "Only the newest message is needed; the session remembers the rest.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"haiku\",\n  \"max_tokens\": 200,\n  \"system\": \"You are a pirate.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"What is my name?\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "End session",
          "request": {
