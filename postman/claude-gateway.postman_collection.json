                "messages"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"haiku\",\n  \"max_tokens\": 100,\n  \"stop_sequences\": [\n    \"STOP\"\n  ],\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Write exactly: alpha beta STOP gamma\"\n    }\n  ]\n}",
              "options": {
